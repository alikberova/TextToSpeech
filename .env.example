# EMAIL
EmailConfig__EmailTo=
EmailConfig__EmailFrom=
EmailConfig__EmailFromPassword=

# NARAKEET
NarakeetConfig__ApiUrl=https://api.narakeet.com
NarakeetConfig__ApiKey=

# ELASTICSEARCH
ElasticsearchConfig__Url=http://elasticsearch:9200
ElasticsearchConfig__Username=elastic
ElasticsearchConfig__Password=

# POSTGRES
POSTGRES_USER=dev
POSTGRES_DB=tts
POSTGRES_PASSWORD=db-password
POSTGRES_EXPOSED_PORT=5433
ConnectionStrings__DefaultConnection=User ID=${POSTGRES_USER};Password=${POSTGRES_PASSWORD};Host=db;Port=5432;Database=${POSTGRES_DB};Pooling=true;Include Error Detail=true;

# JWT
JwtConfig__Issuer=TextToSpeech
JwtConfig__Audience=TextToSpeech.Web
JwtConfig__SigningKey=
JwtConfig__GuestLifetimeMinutes=30

# RabbitMQ
RABBITMQ_USER=tts
RABBITMQ_PASSWORD=local-development-only
RabbitMq__Exchange=tts.jobs
RabbitMq__Queue=tts.jobs.dispatch
RabbitMq__RoutingKey=dispatch
RabbitMq__PublishTimeoutSeconds=10
RabbitMq__PollIntervalSeconds=1
RabbitMq__RetryDelaySeconds=5

# WORKER
Worker__Concurrency=2
Worker__LeaseSeconds=60
Worker__HeartbeatSeconds=1
Worker__RecoveryIntervalSeconds=5

# OTHER
CERTS_PATH=./TextToSpeech.Web/nginx/certs
ConnectionStrings__RedisConnection='redis:6379,allowAdmin=true'
AppDataPath=/app/data
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
IMAGE_TAG_VERSION=local
ANGULAR_PORT=4000
ASPNETCORE_ENVIRONMENT=Staging
ANGULAR_ENVIRONMENT=staging
