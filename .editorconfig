root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4
tab_width = 4
max_line_length = 120

# C# opening braces use separate lines.
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:error
dotnet_style_allow_multiple_blank_lines_experimental = false:error

# Enforce formatting/code-style diagnostics during build.
dotnet_diagnostic.IDE0011.severity = error
dotnet_diagnostic.IDE0055.severity = error

# Menees.Analyzers is included only for deterministic size limits. Disable its unrelated diagnostics individually.
dotnet_diagnostic.MEN001.severity = none
dotnet_diagnostic.MEN002A.severity = none
dotnet_diagnostic.MEN004.severity = none
dotnet_diagnostic.MEN006.severity = none
dotnet_diagnostic.MEN007.severity = none
dotnet_diagnostic.MEN008.severity = none
dotnet_diagnostic.MEN009.severity = none
dotnet_diagnostic.MEN010.severity = none
dotnet_diagnostic.MEN011.severity = none
dotnet_diagnostic.MEN012.severity = none
dotnet_diagnostic.MEN013.severity = none
dotnet_diagnostic.MEN014.severity = none
dotnet_diagnostic.MEN015.severity = none
dotnet_diagnostic.MEN016.severity = none
dotnet_diagnostic.MEN017.severity = none
dotnet_diagnostic.MEN018.severity = none
dotnet_diagnostic.MEN019.severity = none
dotnet_diagnostic.MEN020B.severity = none
dotnet_diagnostic.MEN020S.severity = none
dotnet_diagnostic.MEN020E.severity = none

menees_analyzers.tab_size = 4
menees_analyzers.max_line_columns = 120
menees_analyzers.max_method_lines = 50
menees_analyzers.max_file_lines = 300
menees_analyzers.allow_long_uri_lines = true

# Existing violations are warnings in this PR. A follow-up cleanup PR will remove them before promoting these to errors.
dotnet_diagnostic.MEN002.severity = warning
dotnet_diagnostic.MEN003.severity = warning
dotnet_diagnostic.MEN005.severity = warning

# Existing repository exception.
dotnet_diagnostic.CA1873.severity = none

# EF migrations are generated code; exclude them from style and size analysis.
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0011.severity = none
dotnet_diagnostic.IDE0055.severity = none
dotnet_diagnostic.MEN002.severity = none
dotnet_diagnostic.MEN003.severity = none
dotnet_diagnostic.MEN005.severity = none

[*.{ts,js,html,css,scss}]
indent_size = 2

[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false

[*.{json,jsonc,yml,yaml,xml,csproj,props,targets}]
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false
