{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",

  "EmailConfig": {
    "EmailTo": "receiver@example.com",
    "EmailFrom": "sender@example.com",
    "EmailFromPassword": "aaaa bbbb cccc dddd"
  },

  "NarakeetConfig": {
    "ApiUrl": "https://api.narakeet.com",
    "ApiKey": "narakeet-api-key"
  },

  "ElasticsearchConfig": {
    "Url": "http://localhost:9200",
    "Username": "elastic",
    "Password": "elastic-password"
  },

  "ConnectionStrings": {
    "DefaultConnection": "User ID=dev;Password=db-password;Host=localhost;Port=5432;Database=tts;Pooling=true;Include Error Detail=true;",
    "Redis": "localhost:6379,allowAdmin=true"
  },

  "RabbitMq": {
    "RabbitMqConnection": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "tts",
      "Password": "local-development-only",
      "VirtualHost": "/"
    },
    "RabbitMqTestConnection": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "tts",
      "Password": "local-development-only",
      "VirtualHost": "/"
    },
    "Exchange": "tts.jobs",
    "Queue": "tts.jobs.dispatch",
    "RoutingKey": "dispatch",
    "PublishTimeoutSeconds": 10,
    "PollIntervalSeconds": 1,
    "RetryDelaySeconds": 5
  },

  "JwtConfig": {
    "Issuer": "TextToSpeech",
    "Audience": "TextToSpeech.Web",
    "SigningKey": "base64-encoded-signing-key",
    "GuestLifetimeMinutes": 30
  },

  "AppDataPath": "C:/TtsApp/Data",
  "OPENAI_API_KEY": "openai-secret-key"
}
