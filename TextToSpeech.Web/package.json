{
  "name": "tts-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "cd .. && husky TextToSpeech.Web/.husky"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.23",
    "@angular/compiler": "^21.2.23",
    "@angular/core": "^21.2.23",
    "@angular/forms": "^21.2.23",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.23",
    "@angular/router": "^21.2.23",
    "@microsoft/signalr": "^10.0.11",
    "@ngx-translate/core": "^16.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.4.0",
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.23",
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "21.4.0",
    "eslint": "^9.39.2",
    "husky": "9.1.7",
    "jsdom": "^28.0.0",
    "knip": "^6.37.0",
    "prettier": "3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^4.1.11"
  }
}
